{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Local WinSpot windows. OS access stays behind typed Rust commands.",
  "windows": ["main", "settings"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
